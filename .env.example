# ============================================================
#  Nula na účte — environment variables
#  Copy to `.env` and fill in. `.env` is gitignored.
# ============================================================

# ----- REQUIRED EVERYWHERE -----

# Postgres connection string (Neon).
# Get from Neon dashboard → Connection Details → Pooled connection.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require


# ----- REQUIRED IN PRODUCTION -----

# Sign session JWTs. >= 32 chars. Generate: openssl rand -base64 48
JWT_SECRET=

# Resend API key for sending verify/reset/report emails.
# Get from https://resend.com/api-keys
# In dev: if unset, emails are console.logged with verify URL.
RESEND_API_KEY=

# Resend Inbound webhook signing secret (Svix-style).
# Resend dashboard → Webhooks → your endpoint → Signing Secret. Format: whsec_BASE64
INBOUND_WEBHOOK_SECRET=

# OpenAI API key for transaction categorization & Raul recommendations.
# In dev: if unset, falls back to rule-based categorization & stub recs.
OPENAI_API_KEY=


# ----- OPTIONAL -----

# Domain on which inbound emails are received. Per-user address pattern:
# `${slug}-${token}@${INBOUND_DOMAIN}`
# Default: inbox.local (dev placeholder)
INBOUND_DOMAIN=nula.tvojadomena.sk

# Public origin used for CORS, verify URLs, reset URLs, email CTAs.
# Default: http://localhost:8787 (dev)
PUBLIC_ORIGIN=https://nula-na-ucte.vercel.app

# From address for outgoing emails. Must be on a Resend-verified domain in prod.
EMAIL_FROM=Nula na účte <noreply@nula.tvojadomena.sk>

# Optional shared secret to authorize cron POST endpoints. Vercel cron jobs
# are auto-detected via `x-vercel-cron` header, so this is mainly for manual
# triggers from outside Vercel.
CRON_SECRET=

# NODE_ENV is set automatically by Vercel.
# Locally: leave unset (we treat absence as development).
# NODE_ENV=production
